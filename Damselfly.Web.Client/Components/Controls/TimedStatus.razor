<div class="status">
    <label>@statusText</label>
</div>

@code {
    public void UpdateStatus(string newText)
    {
        if( newText == statusText )
            return;
        
        statusText = newText;
        
        _ = conflator.ConflateAsync((x) => RefreshText(x));
    }

    private Task RefreshText(CancellationToken tok)
    {
        if( ! tok.IsCancellationRequested )
            InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }
    
    private readonly AsyncEventConflator conflator = new();
    private string? statusText = null;
}