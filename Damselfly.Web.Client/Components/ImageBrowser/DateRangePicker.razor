@using System.ComponentModel.Design
<div class="date-picker">
    <div class="filter-type">
        <MudSelect Label="Date Filter" T="DateShortcut?" @bind-Value="@SelectedShortCut" @bind-Value:after="ShortCutChanged"
                   Clearable="true" Dense="true" Margin="Margin.Dense" Variant="UIConstants.MudVariant">
            @foreach ( var choice in DateRanges )
            {
                <MudSelectItem Value="@choice">@choice.name</MudSelectItem>
            }
        </MudSelect>
    </div>
</div>

@code {
    [Parameter] public DateTime? Earliest { get; set; }
    [Parameter] public EventCallback<DateTime?> EarliestChanged { get; set; }

    [Parameter] public DateTime? Latest { get; set; }
    [Parameter] public EventCallback<DateTime?> LatestChanged { get; set; }

    private record DateShortcut( string name, DateRange? range);
    private readonly List<DateShortcut> DateRanges = new();
    private DateShortcut? SelectedShortCut = null;

    protected override void OnInitialized()
    {
        CreateShortcuts();

        base.OnInitialized();
    }
    
    private async Task ShortCutChanged()
    {
        if( SelectedShortCut?.range != null )
        {
            if( Earliest != SelectedShortCut.range.Start )
                await EarliestChanged.InvokeAsync(SelectedShortCut.range.Start);
            
            if( Earliest != SelectedShortCut.range.End )
                await LatestChanged.InvokeAsync(SelectedShortCut.range.End);
        }
        else
        {   
            if( Earliest != null)
                await EarliestChanged.InvokeAsync(null);

            if( Latest != null)
                await LatestChanged.InvokeAsync(null);
        }
    }

    private void AddRangeShortcut(string name, DateRange? range)
    {
        DateRanges.Add(new DateShortcut(name, range));
    }

   
    private void CreateShortcuts()
    {
        // TODO: Add more here
        var Jan1ThisYear = new DateTime(DateTime.UtcNow.Year, 1, 1);

        AddRangeShortcut("This year", new DateRange( Jan1ThisYear, DateTime.UtcNow));
        AddRangeShortcut("Last year", new DateRange (Jan1ThisYear.AddYears(-1), Jan1ThisYear.AddSeconds(-1)));
        AddRangeShortcut($"{Jan1ThisYear.AddYears(-2).Year}", new DateRange(Jan1ThisYear.AddYears(-2), Jan1ThisYear.AddYears(-1).AddSeconds(-1)));
        AddRangeShortcut($"{Jan1ThisYear.AddYears(-3).Year}", new DateRange(Jan1ThisYear.AddYears(-3), Jan1ThisYear.AddYears(-2).AddSeconds(-1)));
        AddRangeShortcut($"{Jan1ThisYear.AddYears(-4).Year}", new DateRange(Jan1ThisYear.AddYears(-4), Jan1ThisYear.AddYears(-3).AddSeconds(-1)));
        AddRangeShortcut($"{Jan1ThisYear.AddYears(-5).Year}", new DateRange(Jan1ThisYear.AddYears(-5),  Jan1ThisYear.AddYears(-4).AddSeconds(-1)));
        AddRangeShortcut($"{Jan1ThisYear.AddYears(-10).Year}", new DateRange(Jan1ThisYear.AddYears(-10), Jan1ThisYear.AddYears(-9).AddSeconds(-1)));
    }
}